<%- include("partials/header") %>
    <title>Home</title>
    <link rel="stylesheet" href="styles/index_style.css">
</head>

<body>
    <%- include("partials/navbar") %>

    <main>
        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-8">
                    <h1 class="page_title">
                        BOOKS
                    </h1>
                </div>

                <div class="col-4 d-flex align-items-center">
                    <div class="input-group">
                        <input type="search" class="form-control" placeholder="Search for items..." aria-label="Search" aria-describedby="button-search">
                        <button id="button-search" type="button" class="btn-solid theme-primary me-2">
                            Search
                        </button>
                    </div>
                </div>
            </div>

            <hr>

            <div class="row my-2 px-5">
                <!-- CARD TEMPLATE -->
                <div class="card p-3">
                    <img class="card-img-top rounded-3" src="images/test_book_cover.jpg" alt="Card image cap">
                    <div class="card-body">
                        <h5 class="card-title">Interesting Book Title</h5>
                        <p class="card-text">A book about something really interesting idk, this is a test.</p>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <div class="category_tag">
                                Tag1
                            </div>
                        </li>

                        <li class="list-group-item d-flex">
                            <div class="col-4">
                                My Rating:
                            </div>
                            <div class="col-8 d-flex justify-content-end">
                                <div class="rating">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                </div>
                            </div>
                        </li>
                    </ul>
                    
                    <div class="card-body">
                        <div class="d-flex justify-content-center">
                            <a href="#" type="button" class="btn-solid theme-primary me-2">
                                Read My Review
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="py-3 mt-4">
        <div class="py-3">
            <p class="text-center">Created by Le Nguyen</p>
            <hr>
            <p class="text-center">Copyright © 2026 Bloginator Web App</p>
        </div>
    </footer>
</body>
</html>